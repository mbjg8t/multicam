from __future__ import annotations

import gi

gi.require_version("Aravis", "0.8")
from gi.repository import Aravis

import numpy as np

from multicam.core.cameras import (
    CameraBackend,
    CameraCapability,
    CameraDevice,
    CameraInfo,
    Frame,
)


class AravisDevice(CameraDevice):

    def __init__(self, info: CameraInfo):
        super().__init__(info)

        device_id = info.metadata.get("aravis_device_id")

        if not device_id:
            raise RuntimeError(
                f"No Aravis device ID available for {info.id}"
            )

        self._camera = Aravis.Camera.new(device_id)

        if self._camera is None:
            raise RuntimeError(
                f"Unable to open Aravis camera: {device_id}"
            )

        self._stream = None
        self._running = False
        self._frame_number = 0

        self._device = self._camera.get_device()
        self._session_defaults = {}

        self._update_identity()
        self._capture_session_defaults()

    def _update_identity(self):
        try:
            serial = self._camera.get_device_serial_number()
        except Exception:
            serial = None

        if serial:
            self.info.serial = serial
            self.info.metadata["device_serial_number"] = serial

    def _get_float_feature(self, name):
        return self._device.get_float_feature_value(name)

    def _set_float_feature(self, name, value):
        self._device.set_float_feature_value(
            name,
            float(value),
        )

    def _get_integer_feature(self, name):
        return self._device.get_integer_feature_value(name)

    def _set_integer_feature(self, name, value):
        self._device.set_integer_feature_value(
            name,
            int(value),
        )

    def _get_boolean_feature(self, name):
        return self._device.get_boolean_feature_value(name)

    def _set_boolean_feature(self, name, value):
        if isinstance(value, str):
            value = value.strip().lower() in {
                "1",
                "true",
                "yes",
                "on",
            }

        self._device.set_boolean_feature_value(
            name,
            bool(value),
        )

    def _try_feature(self, getter, name):
        try:
            return getter(name)
        except Exception:
            return None

    def _capture_session_defaults(self):
        """
        Capture the camera values present when Multicam opens it.

        These are safe session defaults even when the GenICam XML does
        not expose a factory-default value directly.
        """
        features = {
            "exposure": (
                self._camera.get_exposure_time,
                None,
            ),
            "gain": (
                self._get_float_feature,
                "DeviceGain",
            ),
            "black_level": (
                self._get_float_feature,
                "DeviceBlackLevel",
            ),
            "cooling_enable": (
                self._get_boolean_feature,
                "CoolingEnable",
            ),
            "cooling_target": (
                self._get_float_feature,
                "CoolingTargetTemperature",
            ),
            "reverse_x": (
                self._get_boolean_feature,
                "ReverseX",
            ),
            "reverse_y": (
                self._get_boolean_feature,
                "ReverseY",
            ),
        }

        for control_id, (getter, feature_name) in features.items():
            try:
                if feature_name is None:
                    value = getter()
                else:
                    value = getter(feature_name)

                self._session_defaults[control_id] = value
            except Exception:
                pass

    def start(self):
        if self._running:
            return

        self._stream = self._camera.create_stream(None, None)

        if self._stream is None:
            raise RuntimeError(
                f"Unable to create stream for {self.id}"
            )

        payload = self._camera.get_payload()

        for _ in range(16):
            self._stream.push_buffer(
                Aravis.Buffer.new_allocate(payload)
            )

        self._camera.start_acquisition()
        self._running = True

    def stop(self):
        if not self._running:
            return

        try:
            self._camera.stop_acquisition()
        finally:
            self._running = False
            self._stream = None

    def get_frame(self, timeout=None):
        if not self._running or self._stream is None:
            return None

        if timeout is None:
            timeout_us = 1_000_000
        else:
            timeout_us = int(timeout * 1_000_000)

        buffer = self._stream.timeout_pop_buffer(timeout_us)

        if buffer is None:
            return None

        try:
            status = buffer.get_status()

            if status != Aravis.BufferStatus.SUCCESS:
                return None

            width = self._camera.get_region()[2]
            height = self._camera.get_region()[3]

            pixel_format = self._camera.get_pixel_format_as_string()

            data = buffer.get_data()

            if pixel_format == "Mono16":
                image = np.frombuffer(
                    data,
                    dtype=np.uint16,
                ).copy().reshape((height, width))

                bit_depth = 16

            elif pixel_format == "Mono8":
                image = np.frombuffer(
                    data,
                    dtype=np.uint8,
                ).copy().reshape((height, width))

                bit_depth = 8

            else:
                raise RuntimeError(
                    f"Unsupported Aravis pixel format: {pixel_format}"
                )

            self._frame_number += 1

            return Frame(
                camera_id=self.id,
                image=image,
                width=width,
                height=height,
                pixel_format=pixel_format,
                bit_depth=bit_depth,
                frame_number=self._frame_number,
                metadata={},
            )

        finally:
            self._stream.push_buffer(buffer)

    def get_capabilities(self):
        capabilities = []

        def add_float(
            control_id,
            name,
            getter,
            feature_name=None,
            units=None,
            writable=True,
        ):
            try:
                value = (
                    getter()
                    if feature_name is None
                    else getter(feature_name)
                )
            except Exception:
                return

            capabilities.append(
                CameraCapability(
                    id=control_id,
                    name=name,
                    type="float",
                    readable=True,
                    writable=writable,
                    value=value,
                    units=units,
                    metadata={
                        "session_default":
                            self._session_defaults.get(control_id),
                    },
                )
            )

        def add_boolean(
            control_id,
            name,
            feature_name,
        ):
            try:
                value = self._get_boolean_feature(feature_name)
            except Exception:
                return

            capabilities.append(
                CameraCapability(
                    id=control_id,
                    name=name,
                    type="boolean",
                    readable=True,
                    writable=True,
                    value=value,
                    metadata={
                        "session_default":
                            self._session_defaults.get(control_id),
                    },
                )
            )

        # Standard acquisition controls.
        add_float(
            "exposure",
            "Exposure",
            self._camera.get_exposure_time,
            units="us",
        )

        # Some GenICam cameras expose Gain through the standard Aravis
        # helper. Xenics exposes it as DeviceGain. Prefer DeviceGain when
        # present, then fall back to the generic Gain helper.
        try:
            gain = self._get_float_feature("DeviceGain")

            capabilities.append(
                CameraCapability(
                    id="gain",
                    name="Gain",
                    type="float",
                    readable=True,
                    writable=True,
                    value=gain,
                    metadata={
                        "genicam_feature": "DeviceGain",
                        "session_default":
                            self._session_defaults.get("gain"),
                    },
                )
            )
        except Exception:
            try:
                gain = self._camera.get_gain()

                capabilities.append(
                    CameraCapability(
                        id="gain",
                        name="Gain",
                        type="float",
                        readable=True,
                        writable=True,
                        value=gain,
                        metadata={
                            "session_default":
                                self._session_defaults.get("gain"),
                        },
                    )
                )
            except Exception:
                pass

        # Useful image/sensor controls when the camera exposes them.
        add_float(
            "black_level",
            "Black Level",
            self._get_float_feature,
            "DeviceBlackLevel",
        )

        add_boolean(
            "cooling_enable",
            "Cooling",
            "CoolingEnable",
        )

        add_float(
            "cooling_target",
            "Cooling Target",
            self._get_float_feature,
            "CoolingTargetTemperature",
            units="C",
        )

        add_boolean(
            "reverse_x",
            "Flip Horizontal",
            "ReverseX",
        )

        add_boolean(
            "reverse_y",
            "Flip Vertical",
            "ReverseY",
        )

        # Read-only telemetry.
        for feature_name, label in (
            ("DeviceCameraTemperature", "Camera Temperature"),
            ("DeviceTemperature", "Device Temperature"),
        ):
            try:
                temperature = self._get_float_feature(feature_name)

                capabilities.append(
                    CameraCapability(
                        id=feature_name.lower(),
                        name=label,
                        type="float",
                        readable=True,
                        writable=False,
                        value=temperature,
                        units="C",
                        metadata={
                            "genicam_feature": feature_name,
                        },
                    )
                )
            except Exception:
                pass

        # Keep pixel format visible as a capability, but do not expose it
        # in the basic Settings UI yet because changing it affects stream
        # configuration.
        try:
            pixel_format = self._camera.get_pixel_format_as_string()

            capabilities.append(
                CameraCapability(
                    id="pixel_format",
                    name="Pixel Format",
                    type="choice",
                    readable=True,
                    writable=True,
                    value=pixel_format,
                    choices=["Mono8", "Mono16"],
                    metadata={
                        "requires_stream_restart": True,
                    },
                )
            )
        except Exception:
            pass

        return capabilities

    def get_control(self, control_id):
        if control_id == "exposure":
            return self._camera.get_exposure_time()

        if control_id == "gain":
            try:
                return self._get_float_feature("DeviceGain")
            except Exception:
                return self._camera.get_gain()

        if control_id == "black_level":
            return self._get_float_feature("DeviceBlackLevel")

        if control_id == "cooling_enable":
            return self._get_boolean_feature("CoolingEnable")

        if control_id == "cooling_target":
            return self._get_float_feature(
                "CoolingTargetTemperature"
            )

        if control_id == "reverse_x":
            return self._get_boolean_feature("ReverseX")

        if control_id == "reverse_y":
            return self._get_boolean_feature("ReverseY")

        if control_id == "devicecameratemperature":
            return self._get_float_feature(
                "DeviceCameraTemperature"
            )

        if control_id == "devicetemperature":
            return self._get_float_feature(
                "DeviceTemperature"
            )

        if control_id == "pixel_format":
            return self._camera.get_pixel_format_as_string()

        raise KeyError(control_id)

    def set_control(self, control_id, value):
        if control_id == "exposure":
            self._camera.set_exposure_time(float(value))
            return

        if control_id == "gain":
            try:
                self._set_float_feature(
                    "DeviceGain",
                    value,
                )
            except Exception:
                self._camera.set_gain(float(value))
            return

        if control_id == "black_level":
            self._set_float_feature(
                "DeviceBlackLevel",
                value,
            )
            return

        if control_id == "cooling_enable":
            self._set_boolean_feature(
                "CoolingEnable",
                value,
            )
            return

        if control_id == "cooling_target":
            self._set_float_feature(
                "CoolingTargetTemperature",
                value,
            )
            return

        if control_id == "reverse_x":
            self._set_boolean_feature(
                "ReverseX",
                value,
            )
            return

        if control_id == "reverse_y":
            self._set_boolean_feature(
                "ReverseY",
                value,
            )
            return

        if control_id == "pixel_format":
            self._camera.set_pixel_format_from_string(str(value))
            return

        raise KeyError(control_id)

    def get_session_default(self, control_id):
        if control_id not in self._session_defaults:
            raise KeyError(control_id)

        return self._session_defaults[control_id]



class AravisBackend(CameraBackend):
    name = "aravis"

    def discover(self):
        Aravis.update_device_list()

        cameras = []

        for index in range(Aravis.get_n_devices()):
            device_id = Aravis.get_device_id(index)
            vendor = Aravis.get_device_vendor(index)
            model = Aravis.get_device_model(index)
            serial = Aravis.get_device_serial_nbr(index)

            # Aravis can occasionally expose an incomplete USB3Vision
            # discovery entry. Do not attempt to open it; doing so can
            # block startup while the device bootstrap times out.
            if not device_id or device_id in {"-", "--"}:
                continue

            persistent_part = serial or device_id

            camera_id = (
                f"aravis:{vendor or 'camera'}:{persistent_part}"
            )

            cameras.append(
                CameraInfo(
                    id=camera_id,
                    backend=self.name,
                    name=model or camera_id,
                    model=model,
                    vendor=vendor,
                    serial=serial or None,
                    metadata={
                        "aravis_device_id": device_id,
                        "index": index,
                    },
                )
            )

        return cameras

    def open(self, camera_id):
        for info in self.discover():
            if info.id == camera_id:
                return AravisDevice(info)

        raise KeyError(camera_id)
